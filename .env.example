CRAWLER_PER_DOMAIN_CONCURRENCY=1
CRAWLER_REQUEST_DELAY_MS=1500
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RESPONSE_BYTES=2000000

