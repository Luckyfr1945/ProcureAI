APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=development

DATABASE_URL=sqlite://instance/procure_ai.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SEARCH_PROVIDER=live
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

MAX_JOB_DURATION_SECONDS=900
MAX_SEARCH_REQUESTS_PER_JOB=40
MAX_CRAWL_PAGES_PER_JOB=80
MAX_CONCURRENT_FETCHES=5
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_BYTES=2000000
CRAWLER_REQUEST_DELAY_MS=1000

SESSION_SECRET=replace-with-a-long-random-secret-min-32-characters
RUST_LOG=info
