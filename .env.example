APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=development

DATABASE_URL=sqlite://instance/procure_ai.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SEARCH_PROVIDER=mock
SEARCH_API_KEY=
